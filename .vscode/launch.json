{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "启动 MkDocs 服务器",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script/create_mkdocs_yml.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "stopOnEntry": false,
            "showReturnValue": true
        }
    ]
}